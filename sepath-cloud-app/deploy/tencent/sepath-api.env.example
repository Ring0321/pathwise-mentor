NODE_ENV=production
HOST=127.0.0.1
PORT=8787

SEPATH_PRIVACY_MODE=pseudonymous
SEPATH_ALLOWED_ORIGINS=http://212.129.243.63
SEPATH_DATA_FILE=/var/lib/sepath/sepath-edge-store.json

LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=replace-with-model-name
LLM_API_KEY=replace-with-fresh-server-side-key

# For a locked production pilot, set these and issue short-lived access tokens.
# Leaving them empty keeps the first online smoke usable with pseudonymous data only.
SEPATH_DEPLOY_ENV=
SEPATH_AUTH_SECRET=
SEPATH_TEACHER_ACCESS_CODE=
SEPATH_TOKEN_ISSUER_SECRET=
SEPATH_RETURN_SECRET=
SEPATH_GITHUB_WEBHOOK_SECRET=
